<Window x:Class="VPSnode.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VPSnode" Width="1080" Height="690" MinWidth="680" MinHeight="460"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="142"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Border Background="{DynamicResource MutedSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="9,10">
    <TextBlock DockPanel.Dock="Top" Text="▤  VPSnode" FontSize="19" FontWeight="SemiBold" Margin="6,6,0,16"/>
    <StackPanel DockPanel.Dock="Bottom">
     <Button x:Name="TasksButton" Content="任务中心" Margin="0,0,0,4"/>
     <TextBlock x:Name="TaskLabel" TextWrapping="Wrap" FontWeight="SemiBold"/>
     <ProgressBar x:Name="TaskProgress" Height="4" Margin="0,4" Foreground="{DynamicResource Accent}"/>
     <TextBlock x:Name="TaskCounts" Foreground="{DynamicResource Quiet}" TextWrapping="Wrap" FontSize="12"/>
     <TextBlock x:Name="LastTask" Foreground="{DynamicResource Quiet}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,6"/>
     <Button x:Name="StopTask" Content="取消当前任务" Visibility="Collapsed" Margin="0,0,0,6"/>
     <TextBlock x:Name="StatusLine" Foreground="{DynamicResource Quiet}" Text="●  巡检运行中" Margin="5,6,0,2" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </StackPanel>
    <StackPanel x:Name="Navigation"/>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" x:Name="Scroller">
   <Border Width="{Binding ViewportWidth, ElementName=Scroller}" x:Name="PageFrame" Padding="14,11"><ContentControl x:Name="PageBody" HorizontalContentAlignment="Stretch" Focusable="False"/></Border>
  </ScrollViewer>
 </Grid>
</Window>
