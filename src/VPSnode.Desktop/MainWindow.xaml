<Window x:Class="VPSnode.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VPSnode" Icon="Assets/VPSnode.ico" Width="1220" Height="740" MinWidth="680" MinHeight="460"
 UseLayoutRounding="True" SnapsToDevicePixels="True"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" TextOptions.TextFormattingMode="Display"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}">
 <Grid Background="{DynamicResource Canvas}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource MutedSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="10,0" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="16"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,18,0,20">
      <Image Source="Assets/VPSnode.png" Width="25" Height="25" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="VPSnode" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="BrandVersion" FontSize="10" Foreground="{DynamicResource Quiet}" Margin="5,0,0,3" VerticalAlignment="Bottom"/>
     </StackPanel>
     <StackPanel x:Name="Navigation" Grid.Row="1"/>
     <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10">
      <StackPanel>
       <Button x:Name="TasksButton" Content="任务中心  ›" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
       <TextBlock x:Name="TaskLabel" TextWrapping="Wrap" FontWeight="SemiBold"/>
       <ProgressBar x:Name="TaskProgress" Height="5" Margin="0,9,0,7" Foreground="{DynamicResource Accent}"/>
       <TextBlock x:Name="TaskCounts" Foreground="{DynamicResource Quiet}" TextWrapping="Wrap" FontSize="12"/>
       <Border Height="1" Background="{DynamicResource Line}" Margin="0,10"/>
       <TextBlock x:Name="LastTask" Foreground="{DynamicResource Quiet}" TextWrapping="Wrap" FontSize="12"/>
       <Button x:Name="StopTask" Content="取消当前任务" Visibility="Collapsed" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock Grid.Row="4" x:Name="StatusLine" Foreground="{DynamicResource Quiet}" FontSize="12" Text="本机任务就绪" Margin="3,10,3,18" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Grid>
   </ScrollViewer>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" x:Name="Scroller">
   <Border Width="{Binding ViewportWidth, ElementName=Scroller}" x:Name="PageFrame" Padding="16,14"><ContentControl x:Name="PageBody" HorizontalContentAlignment="Stretch" Focusable="False"/></Border>
  </ScrollViewer>
 </Grid>
</Window>
