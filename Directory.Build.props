<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.9</Version>
    <VpsBuildDate>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd"))</VpsBuildDate>
    <SatelliteResourceLanguages>zh-Hans;zh-CN;en;en-US</SatelliteResourceLanguages>
    <Company>VPSnode</Company>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildDateUtc" Value="$(VpsBuildDate)" />
  </ItemGroup>
</Project>
